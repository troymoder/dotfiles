export LD_LIBRARY_PATH="/nix/store/mp9krn4yrm1hwh657y1aa2jv0x97fbin-libxkbcommon-1.13.2/lib:/nix/store/wwfxbskbriy9w5cyabx4z2sdak6n6jvs-libglvnd-1.7.0/lib:/nix/store/d6ygipmny4pw7h61b255yafbnvqjbmnx-libx11-1.8.14/lib:/nix/store/12c7cfgyy0mrwya6vizqs6bzfvp4fgdc-libxcursor-1.2.3/lib:/nix/store/3wp2a2rafjwa3amvbp66l9l529a7sbg9-libxi-1.8.4/lib:/nix/store/d5dsf0h0r0fpi48rgvi7hmnac3mzj2s8-libxcb-1.17.0/lib:/nix/store/8vz293r6dqfci9p6m955yziz2agxx990-wayland-1.26.0/lib:/nix/store/la62431p5qf1ggr3rdzql9dksv5fhicc-vulkan-loader-1.4.363.0/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/share}:/run/current-system/sw/share:/nix/store/p5hykf6q6rx4km05k3q4c754vz299d6d-cosmic-applets-1.11.0/share:/nix/store/12azdaiwqmwr3zjwj1k2im6b7a7aqwsn-cosmic-fallback-themes/share:/nix/store/y89kj6p9q740cavqhcnan9afhzcx5yhy-cosmic-icons-1.11.0/share"
export QS_FONT_DIR="$here/.dev/cantarell-fonts/share/fonts"
# The search's qalc and fd, as the package's wrapper puts them on PATH
# (GC-rooted out-links of <nixpkgs>' libqalculate and fd).
export PATH="$here/.dev/libqalculate/bin:$here/.dev/fd/bin:$PATH"
export CABIN_WEB_ICONS="$here/.dev/papirus-icon-theme/share/icons/Papirus/64x64/apps"
