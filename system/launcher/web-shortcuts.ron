// Web search shortcuts for the launcher (pop-launcher "web" plugin): type the
// prefix, a space, and the query. Replaces the stock list of ~40 engines.
(
    rules: [
        (
            matches: ["g", "gs", "google"],
            queries: [(name: "Google", query: "google.com/search?q=")]
        ),
        (
            matches: ["ddg"],
            queries: [(name: "DuckDuckGo", query: "duckduckgo.com/?q=")]
        ),
        (
            matches: ["yt", "youtube"],
            queries: [(name: "YouTube", query: "youtube.com/results?search_query=")]
        ),
        (
            matches: ["gh", "github"],
            queries: [(name: "GitHub", query: "github.com/search?q=")]
        ),
        (
            matches: ["wiki"],
            queries: [(name: "Wikipedia", query: "wikipedia.org/w/index.php?search=")]
        ),
        (
            matches: ["nix", "nixpkgs"],
            queries: [(name: "Nix packages", query: "search.nixos.org/packages?query=")]
        ),
        (
            matches: ["nixo", "nixopts"],
            queries: [(name: "NixOS options", query: "search.nixos.org/options?query=")]
        ),
    ],
)
