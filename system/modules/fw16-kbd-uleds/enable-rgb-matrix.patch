 static int qmk_set(const target_t *t, unsigned pct) {
     unsigned char val = (unsigned char)((pct * 255 + 50) / 100);
+    // QMK silently ignores rgb_matrix brightness writes while the matrix is disabled
+    // (effect 0), which is how the Framework 16 keyboard ends up stuck. Turn it on
+    // (effect 1 = solid colour) before asking for a visible brightness.
+    if (pct > 0) {
+        unsigned char eff = 0;
+        if (qmk_hidraw_xfer(t->hidraw, QMK_CMD_GET_VALUE, QMK_CH_RGB_MATRIX, QMK_ADDR_EFFECT, 0, &eff) == 0 && eff == 0)
+            (void)qmk_hidraw_xfer(t->hidraw, QMK_CMD_SET_VALUE, QMK_CH_RGB_MATRIX, QMK_ADDR_EFFECT, 1, NULL);
+    }
     // Try both white backlight and RGB matrix
     int r1 = qmk_hidraw_xfer(t->hidraw, QMK_CMD_SET_VALUE, QMK_CH_BACKLIGHT, QMK_ADDR_BRIGHTNESS, val, NULL);
     int r2 = qmk_hidraw_xfer(t->hidraw, QMK_CMD_SET_VALUE, QMK_CH_RGB_MATRIX, QMK_ADDR_BRIGHTNESS, val, NULL);
